# Booleans accept true/false, yes/no, on/off, or 1/0. Case does not matter.
# At least one of DNS or the firewall must end up enabled.

# Required. OAuth client id from the Contabo panel. Trimmed. Blank is rejected.
CONTABO_CLIENT_ID=
# Required. OAuth client secret. Not trimmed. Blank is rejected.
CONTABO_CLIENT_SECRET=
# Required. API user (email). Trimmed. Blank is rejected.
CONTABO_API_USER=
# Required. API password. Not trimmed. Blank is rejected.
CONTABO_API_PASSWORD=

# Optional. Default https://api.contabo.com. Must be an https URL.
CONTABO_API_BASE=https://api.contabo.com
# Optional. Default is the Contabo token endpoint. Must be an https URL.
CONTABO_AUTH_URL=https://auth.contabo.com/auth/realms/contabo/protocol/openid-connect/token

# Optional. Default true. false waits INTERVAL_SECONDS before the first sync.
RUN_ON_START=true
# Optional. Default 300. 0 runs once and exits. Any other value must be >= 30.
# false combined with 0 is rejected, because the process would never sync.
INTERVAL_SECONDS=300
# Optional. Default false. true logs DNS and firewall writes and skips POST, PATCH, and PUT.
DRY_RUN=false

# Optional. Default https://ipecho.net/plain. Comma-separated https URLs, tried in order.
# Answers that are private, loopback, link-local, 100.64.0.0/10, or 198.18.0.0/15 are skipped.
IP_ECHO_URL=https://ipecho.net/plain,https://ifconfig.me/ip
# Optional. Default 10. Seconds for each echo request. Must be >= 1.
IP_ECHO_TIMEOUT_SECONDS=10

# Optional. Default true when DNS_RECORDS is set, otherwise false.
# true requires DNS_RECORDS. false turns DNS off even when DNS_RECORDS is set.
DNS_ENABLED=true
# Required while DNS is enabled. Comma-separated names.
# home.example.com updates that A record. example.com is the zone apex (@).
# *.example.com updates existing A records in that zone and its children.
# Wildcards do not create records. Other record types are left alone.
DNS_RECORDS=home.example.com,*.example.com
# Optional. Empty keeps the API's TTL. A set value must be >= 1.
DNS_TTL=
# Optional. Default false. true creates a missing A record for an exact name only.
DNS_CREATE_MISSING=false

# Optional. Default true when FIREWALL_RULES is set, otherwise false.
# true requires FIREWALL_RULES. false turns the firewall off even when rules are set.
FIREWALL_ENABLED=true
# Set exactly one of FIREWALL_ID or FIREWALL_NAME.
FIREWALL_ID=
# Exact firewall name. Cached after lookup until a GET for that id returns 404.
FIREWALL_NAME=
# Required while the firewall is enabled. JSON array of displayName + sources.
# A source is an IPv4 address, an IPv4 CIDR, a hostname (each A record becomes /32), or current.
# current is the address from IP_ECHO_URL. Duplicates are dropped. Order is kept.
FIREWALL_RULES=[{"displayName":"SSH","sources":["203.0.113.5","home.example.net","current"]}]

# Optional. Default both.
# both: embedded Mozilla roots and the image ca-certificates bundle.
# webpki: embedded Mozilla roots only.
# native: the system or image bundle only.
TLS_ROOTS=both

# Optional. Default info. One of error, warn, info, debug, trace.
LOG_LEVEL=info
# Optional. Default /var/log/contabo-ddns. An empty value logs to stdout only.
LOG_DIR=/var/log/contabo-ddns
# Optional. Default contabo-ddns.log. A file name, not a path.
LOG_FILE=contabo-ddns.log
# Optional. Default 10. Megabytes before the file rolls. Must be >= 1.
LOG_ROTATE_SIZE_MB=10
# Optional. Default 5. How many rolled files to keep. 1 to 10000.
LOG_ROTATE_KEEP=5
# Optional. Default true. false requires a non-empty LOG_DIR.
LOG_TO_STDOUT=true

# Optional. Default 127.0.0.1:8080. Loopback GET /health for the container healthcheck.
# A non-loopback address is rejected. Do not publish this port.
HEALTHCHECK_BIND=127.0.0.1:8080
